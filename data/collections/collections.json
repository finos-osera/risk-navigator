      "stage_posture": "early_stage_experimental",
      "organizations": ["finos-labs"],
      "include_archived": false,
      "include_forks": false,
      "default_branch_only": true,
      "opt_in_release_branches": [],
      "excluded_repositories": [],
      "supported_ecosystems": ["maven", "npm", "pypi"],
      "scan_limits": {
        "max_manifests_per_repo": 32,
        "max_lockfiles_per_repo": 4,
        "github_parallelism": 12
      },
      "refresh_cadence": "weekly",
      "output_paths": {
        "dataset": "data/finos-labs.json",
        "coverage_report": "data/finos-labs-coverage.json",
        "receipt": "data/receipts/finos-labs.receipt.json"
      }
    }
  ],
  "curated_demos": [
